%table
  %thead
    %tr
      %th 項目
      %th 料金
      %th 支払状況
      %th 領収

  %tbody
    - @entry.entry_fees.each_with_index do |fee, index|
      - field_name = "entry[entry_fees_attributes][#{index}]"
      %tr
        %td= fee.event_fee.name
        %td= number_to_currency(fee.event_fee.sum, unit: '円', precision: 0, format: '%n %u')
        - if fee.paid
          %td.paid 領収済
        - else
          %td.not-paid 未領収
        %td
          = hidden_field_tag "#{field_name}[id]", fee.id
          = hidden_field_tag "#{field_name}[paid]", '0', id: nil
          = check_box_tag "#{field_name}[paid]", '1', fee.paid, aria: {label: "#{fee.event_fee.name}を領収済みにする"}

  %tfoot
    %tr
      %th{colspan: 2}
      %th 合計
      %td= number_to_currency(@entry.fees_sum, unit: '円', precision: 0, format: '%n %u')
