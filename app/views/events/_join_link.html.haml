- unless @entry.nil?
  = render(:partial => "entries/ticket")
  - if @event.joinable_period_begin < Time.now && Time.now < @event.joinable_period_end
    %div{align: :center}
      = button_to '参加をキャンセルする', event_entry_path(@event, @entry),
        method: :delete, class: 'btn danger',
        form: {data: {confirm: '本当にキャンセルしますか？再度参加登録する際に優先されることはありません。'}}
- else
  - if @event.joinable_period_begin < Time.now && Time.now < @event.joinable_period_end
    .joinLink
      - if @remain > 0 ##残り人数によって表示を変更
        %div{align: :center}
          = link_to "このイベントに参加する",
            new_event_entry_path(@event),
            class: 'btn primary large'
      - else
        %h3 このイベントの参加者は満員となりました。
