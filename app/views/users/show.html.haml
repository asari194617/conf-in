.page-header
  %h1
    = twicon_tag @user, :bigger
    = @user.name

.row
  .span10
    %table
      %tr
        %th 自己紹介
        %td= hbr @user.memo
      %tr
        %th Twitter
        %td= link_to "@"+@user.tw_id,"https://twitter.com/#{@user.tw_id}",
          target: '_blank' unless @user.tw_id.blank?
      %tr
        %th Webサイト
        %td= website_link @user.website, target: '_blank', rel: 'noopener'
      %tr
        %th 職業
        %td= @user.job
      %tr
        %th 勤務先・学校
        %td= @user.office
    %h2 旅のあしあと
    - if @events.any?
      %ul
        - @events.each do |event|
          %li
            = link_to event.name, event
            = link_to '会場の地図', google_maps_url(event.place_address), target: '_blank', rel: 'noopener' if event.place_address.present?
    - else
      %p 参加したイベントはありません。
  .span6
    %h3= "#{@user.name}が参加したイベント"
    %ul
      - unless @user.entries.blank?
        - @user.entries.each do |entry|
          %li= link_to entry.event.name, entry.event
    %h3= "#{@user.name}が主催したイベント"
    %ul
      - unless @user.hosted_events.blank?
        - @user.hosted_events.each do |hosted_event|
          %li= link_to hosted_event.name, hosted_event
