!!!
%html{lang: 'ja'}
  %head
    %meta{charset: 'utf-8'}
    %meta{name: 'viewport', content: 'width=device-width, initial-scale=1'}
    %title= title
    = stylesheet_link_tag 'application'
    = javascript_include_tag 'application', defer: true
    = csrf_meta_tags
  %body
    .topbar
      %nav.container{aria: {label: 'メインナビゲーション'}}
        = render 'common/header'
    %main.container
      .content
        - if notice
          .alert-message.info{role: 'status'}= notice
        - if alert
          .alert-message.warning{role: 'alert'}= alert
        - if flash[:danger]
          .alert-message.danger{role: 'alert'}= flash[:danger]
        = yield
