= link_to 'カンファイン', root_path, class: 'brand'
- if current_user
  %button.nav-link{type: 'button', data: {open_dialog: 'send_qr'}} 受付用QRコード
%details.dropdown
  %summary イベント
  %ul.dropdown-menu
    %li= link_to '作成する', new_event_path
    %li= link_to '一覧を見る', events_path
%details.dropdown
  %summary ヘルプ
  %ul.dropdown-menu
    %li= link_to '使い方', help_path
    %li= link_to 'カンファインについて', about_path
    %li= link_to 'お問い合わせ', help_path(anchor: 'contact')
    %li= link_to '意見・バグ報告', 'https://spreadsheets.google.com/spreadsheet/viewform?hl=ja&authkey=CLKJ6ZsF&formkey=dEVvcWF1cWJKTFpMSzZuSFVvcW9JZFE6MQ#gid=0', target: '_blank', rel: 'noopener'

.nav-account
  - if current_user
    = link_to twicon_tag(current_user, :mini), current_user
    %details.dropdown
      %summary= current_user.name
      %ul.dropdown-menu
        %li= link_to '設定', edit_user_registration_path
        %li= button_to 'ログアウト', destroy_user_session_path, method: :delete
  - else
    = link_to 'ユーザ登録', new_user_registration_path
    = link_to 'ログイン', new_user_session_path

- if current_user
  %dialog#send_qr{aria: {labelledby: 'send-qr-title'}}
    = render 'users/send_qr'
